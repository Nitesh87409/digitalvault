# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/digitalvault

# JWT Secret (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# Razorpay (get from razorpay.com dashboard)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Email (Gmail SMTP)
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=DigitalVault <your@gmail.com>

# Site URL (for download links)
SITE_URL=https://yourdomain.com

# Admin default credentials (used only for first setup)
ADMIN_EMAIL=admin@digitalvault.in
ADMIN_PASSWORD=Admin@123
